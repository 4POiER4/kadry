# Скопируйте в .env и поменяйте значения:  cp .env.example .env

# Порт на хосте, по которому открывается приложение
HOST_PORT=8163

# Часовой пояс (метки времени в отчёте и на плашке публикации)
TZ=Europe/Minsk

# Учётные данные для входа (один общий логин отдела кадров)
HR_USERNAME=kadry
HR_PASSWORD=kadry

# Секрет для подписи cookie-сессии. Задайте длинную случайную строку.
SECRET_KEY=please-change-this-to-a-long-random-string

# Параметры расчёта (можно не трогать)
LUNCH_MINUTES=45
ARRIVAL_WINDOW_START=08:00
ARRIVAL_WINDOW_END=08:58
# Норма ПРИСУТСТВИЯ по проходной (вход -> выход), ДО вычета обеда.
# Чистая работа = присутствие − LUNCH_MINUTES:
#   Пн–Чт: 9:02 присутствия -> 8:17 чистой работы
#   Пт:    7:47 присутствия -> 7:02 чистой работы
REQUIRED_PRESENCE_MON_THU=9:02
REQUIRED_PRESENCE_FRI=7:47

# Срок жизни сессии (часы)
SESSION_HOURS=12
